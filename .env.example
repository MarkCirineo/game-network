# ArcadeKit Environment Variables

# Public URL of the site (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket URL (client connects here)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Game server internal URL (Next.js API routes call this)
GAME_SERVER_INTERNAL_URL=http://localhost:3001

# Redis URL (game server state persistence)
REDIS_URL=redis://localhost:6379

# Google AdSense
# Get your publisher ID from https://adsense.google.com
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=

# Amazon Associates
# Your Amazon Associates affiliate tag
# Get it from https://affiliate-program.amazon.com
NEXT_PUBLIC_AMAZON_TAG=

# Discord webhook for the footer Feedback form (server-only secret, never NEXT_PUBLIC_)
# Discord: channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
# Leave empty in dev: feedback is logged to the Next.js console instead.
# Production: put it in docker/.env (gitignored), NOT .env.production (committed to git).
DISCORD_FEEDBACK_WEBHOOK_URL=

# ── Accounts (Better Auth + Postgres + Resend) ───────────────
# Local Postgres: yarn db:up (docker/docker-compose.dev.yml, port 5433)
DATABASE_URL=postgres://arcadekit:arcadekit@localhost:5433/arcadekit

# Better Auth: the site's own URL, and a random secret (32+ bytes).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google sign-in (Google Cloud Console → Credentials → OAuth client ID, Web).
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (account emails). Leave empty in dev: emails, including sign-in
# codes, are printed to the Next.js console instead.
RESEND_API_KEY=
EMAIL_FROM=ArcadeKit <no-reply@arcadekit.games>

# Discord webhook for operator alerts (email failures, daily email count).
# Falls back to DISCORD_FEEDBACK_WEBHOOK_URL when empty.
DISCORD_ALERTS_WEBHOOK_URL=
